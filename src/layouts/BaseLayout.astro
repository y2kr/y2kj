---
import { Image } from 'astro:assets';
import logo from '../assets/jh_logo.png';
import '../styles/global.css';

interface Props {
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `JH > ${title}` : 'JH';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}files/imgs/icon.png`} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ home: !title }}>
    <div class="star-background" aria-hidden="true"></div>
    <header>
      <a href={base} aria-label="Home">
        <Image src={logo} alt="" loading="eager" />
      </a>
    </header>
    <main>
      <slot />
    </main>
    <script>
      import '../scripts/stars';
    </script>
  </body>
</html>
